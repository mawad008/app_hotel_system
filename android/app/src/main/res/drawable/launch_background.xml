<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch window: white field + the vector brand mark at 120dp,
     raised 20.5dp (bottom inset 41dp) so it lands exactly where the Flutter splash
     (EntrySplashBackdrop) paints its mark above the wordmark. Android 12+ uses the
     SplashScreen API instead (values-v31/styles.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item
        android:bottom="41dp"
        android:drawable="@drawable/launch_logo"
        android:gravity="center"
        android:width="120dp"
        android:height="120dp" />
</layer-list>
