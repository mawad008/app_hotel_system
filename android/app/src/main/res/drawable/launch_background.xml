<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch window: a plain white field. The logo is
     dashboard-managed, so no bundled mark is shown here; the Flutter splash
     (EntrySplashBackdrop) paints the uploaded logo / app name. Android 12+ uses
     the SplashScreen API instead (values-v31/styles.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
</layer-list>
