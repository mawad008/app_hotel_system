<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash icon: intentionally empty. Without an icon the
     SplashScreen API shows the launcher icon; the logo is dashboard-managed, so
     the native splash stays a plain white field until the Flutter splash paints
     the uploaded logo / app name. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="288dp" android:height="288dp" />
</shape>
