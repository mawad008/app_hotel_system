<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing is copied to cloud backup or to a new device. The
     access token is encrypted with a Keystore key that never leaves this
     device, so a restored copy could not be read anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
