<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) replaces windowBackground with the system SplashScreen.
         Without these items it shows the launcher icon (the default Flutter icon) masked
         into a circle. The splash is always white like the Flutter splash, which is
         pinned to the light theme, so the night variant is identical. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
